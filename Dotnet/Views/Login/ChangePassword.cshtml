@model ChangePassword

@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}



<form asp-action="ChangePassword" asp-controller="Login" class="max-w-sm mx-auto">
    <div asp-validation-summary="ModelOnly" class="text-red-700"></div>
    <div class="mb-5">
        <label asp-for="CurrentPassword" class="block mb-2.5 text-sm font-medium text-heading">Your Current password</label>
        <input asp-for="CurrentPassword"  class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="........" required />
        <span asp-validation-for="CurrentPassword" class="text-red-700"></span>
    </div>
    <div class="mb-5">
        <label asp-for="NewPassword" class="block mb-2.5 text-sm font-medium text-heading">Your new password</label>
        <input asp-for="NewPassword" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="••••••••" required />
        <span asp-validation-for="NewPassword" class="text-red-700"></span>
    </div>

    <div class="mb-5">
        <label asp-for="ConfirmPassword" class="block mb-2.5 text-sm font-medium text-heading">ReEnter confirm password</label>
        <input asp-for="ConfirmPassword" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="••••••••" required />
        <span asp-validation-for="ConfirmPassword" class="text-red-700"></span>
    </div>
    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">
        Update password
    </button>
    
</form>
